# ── Clinical Voice Agent — variables de entorno ──────────────────────────────
# Copia este archivo a `.env` y rellena las claves. `.env` está en .gitignore.
# El sistema arranca HOY solo con VOYAGE_API_KEY (embeddings) y el LLM en modo mock.

# ── Base de datos (docker compose la levanta como servicio `db`) ─────────────
DATABASE_URL=postgresql+psycopg://clinical:clinical@localhost:5432/clinical

# ── LLM (ADR-002: adaptador intercambiable) ──────────────────────────────────
# mock       -> determinista, sin API key (por defecto; corre sin credenciales)
# anthropic  -> implementación provisional hasta el modelo obligatorio (7 ago)
LLM_PROVIDER=mock
# Necesaria solo si LLM_PROVIDER=anthropic. Consíguela en https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo provisional. Para el presupuesto de latencia de voz (<1.5s) considera
# un modelo más rápido. ⏳ se reemplaza por el modelo obligatorio el 7 de agosto.
ANTHROPIC_MODEL=claude-opus-4-8

# ── Embeddings — Voyage AI (simula Databricks en el test) ────────────────────
# NECESARIA AHORA para construir la base de embeddings. https://www.voyageai.com/
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# ── Voz (Pipecat) — solo para el modo de voz real ───────────────────────────
# Activa el modo voz reconstruyendo con INSTALL_VOICE=true docker compose up --build
# STT: Deepgram (https://deepgram.com) · TTS: ElevenLabs (https://elevenlabs.io)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=         # key con permisos Text to Speech + Voices (read)
# OBLIGATORIA para voz: ID de una voz NATIVA es-CO/latina de la Voice Library
# (las voces por defecto arrastran acento inglés al español). ADR-007.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# ── RAG ──────────────────────────────────────────────────────────────────────
RAG_TOP_K=4
RAG_MIN_CONFIDENCE=0.55

# ── Dataset real (⏳ 7 de agosto, Databricks Delta Share) ────────────────────
# DATABRICKS_SHARE_PROFILE=/path/to/config.share

# ── Framework de evaluación (tests/) ─────────────────────────────────────────
# El runner lee estas variables desde .env (o desde la shell, que tiene prioridad).
# OJO: el AGENTE bajo prueba se elige con LLM_PROVIDER/ANTHROPIC_MODEL de arriba;
# estas EVAL_* configuran el evaluador, no el agente.
EVAL_RUNNER=http            # inprocess (llama process_turn) | http (POST al backend)
EVAL_BASE_URL=http://localhost:8000
EVAL_JUDGE=anthropic        # anthropic (juez LLM) | heuristic (offline, sin API key)
# Modelo del JUEZ evaluador. Vacío -> usa ANTHROPIC_MODEL. Un modelo rápido/barato
# (p.ej. claude-haiku-4-5-20251001) abarata la evaluación sin tocar el agente.
EVAL_MODEL=claude-haiku-4-5-20251001
