# ── Clinical Voice Agent — variables de entorno ──────────────────────────────
# Copia .env.example a .env y rellena GROQ_API_KEY. Es la ÚNICA credencial.
# El LLM vive en Groq; la voz de salida (Kokoro) y los embeddings (bge-m3)
# corren en local, sin claves.

# ── STT: Groq Whisper ────────────────────────────────────────────────────────
# Gratis en https://console.groq.com — un minuto, sin tarjeta.
# La compuerta G3 restringe el modelo que RAZONA, no el reconocimiento de voz.
GROQ_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# ── LLM: sucesor vigente de Llama en Groq (compuerta G3) ─────────────────────
# De los cuatro modelos permitidos por el reto, Gemini 1.5 Flash está retirado y
# Llama 3.1 70B fue decomisionado de Groq. La nota del reto permite el sucesor
# vigente del mismo proveedor. En Groq, llama-3.3-70b-versatile se apaga el
# 16-ago-2026; cuando ocurra, usar la familia Llama 4 (meta-llama/llama-4-*).
# GROQ_API_KEY (más arriba) sirve tanto para STT como para el LLM.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_S=2.5

# ── Embeddings: bge-m3, servido por Ollama local ─────────────────────────────
# G3 restringe el modelo que razona, no los embeddings. El LLM vive en Groq pero
# bge-m3 sigue corriendo en el Ollama local; conservar OLLAMA_HOST es obligatorio.
#   ollama pull bge-m3
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ── TTS local (sin clave) ─────────────────────────────────────────────────────
# piper (por defecto): acento español nativo, entrenado por idioma. Pierde GPL.
# kokoro: español vía G2P de misaki/espeak-ng (el de leonelhs/kokoro-tts-spanish);
# se fuerza Language.ES en el servicio para que no suene con acento inglés. Ver
# la comparación medida en docs/spikes-7-agosto.md.
#   piper  -> es_MX-claude-high (por defecto), es_AR-daniela-high, es_ES-*
#   kokoro -> ef_dora (F), em_alex (M), em_santa (M)
TTS_PROVIDER=piper
TTS_VOICE=es_MX-claude-high
# Espera antes de dar por terminado el turno del paciente. 0.7 s protege a quien
# hace pausas; bajarlo recorta latencia a costa de cortarle.
VAD_STOP_SECS=0.7

# ── Estado de la conversación: SQLite, sin servidor ──────────────────────────
DATABASE_URL=sqlite:///./data/clinical.db

# ── RAG: ChromaDB ────────────────────────────────────────────────────────────
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=clinical_knowledge
RAG_TOP_K=4
RAG_FETCH_K=12
# ⚠️ Calibrar con scripts/calibrate_rag.py. El 0.55 venía de voyage-3 y no
# transfiere: con bge-m3 las similitudes observadas van de 0.75 a 0.79.
RAG_MIN_CONFIDENCE=0.55
CHUNK_SIZE=900
CHUNK_OVERLAP=180
